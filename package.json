{
  "name": "domustudio-mcp-server",
  "version": "0.4.0",
  "description": "MCP server exposing the Danea Domustudio public API (condomini, persone, fornitori) as read-only tools.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "author": "Juri Sacchetta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juriSacchetta/Domustudio-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/juriSacchetta/Domustudio-mcp/issues"
  },
  "homepage": "https://github.com/juriSacchetta/Domustudio-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "domustudio",
    "danea",
    "condominio"
  ],
  "bin": {
    "domustudio-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "tsc && vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test:unit": "vitest run",
    "test:live": "tsc && DOMUSTUDIO_LIVE=1 vitest run test/live.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
