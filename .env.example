# Copy to .env and fill in real keys. .env is gitignored — never commit it.
# One API key addresses one Domustudio archive; list every archive you need.
DOMUSTUDIO_ARCHIVES=[{"name":"desa","api_key":"..."}]

# Override only for tests or a mock. Production leaves this unset.
# DOMUSTUDIO_BASE_URL=https://domustudioapi.danea.it/api/external
